    "baseItemValue": 1,
    "preferenceWeights": { "favorite": 2, "like": 1, "dislike": -1, "strongDislike": -2 },
    "itemValue": "Start each item at +1, then add all matching preference adjustments. Unlisted attributes add zero.",
    "satisfactionScale": { "minimum": null, "maximum": null, "mapping": "raw-total" },
    "notes": "An empty allotment scores 0. Show raw allotment totals without clamping or /10; total score is the sum of all four characters. Strong dislikes are supported but no current profile uses them. Sweet, Candy Bar, and Sugar Free are not scoring attributes."
